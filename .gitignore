/target
/.claude
/dist
/node_modules
/src-tauri/target

# Tauri codegen output. Regenerated on every build and named per build host
# (linux-schema.json, windows-schema.json, ...), so it dirties the tree
# differently depending on who built last.
/src-tauri/gen/schemas

# Developer-local runtime config. Use config.example.toml as the template;
# never commit machine-specific addresses or environment details.
/nexthop.toml
/src-tauri/nexthop.toml

# Secret material — never commit. A relay that terminates TLS or signs Tauri
# updates is exactly where a stray key ends up.
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
id_rsa
id_ed25519
secrets.*
credentials.*
